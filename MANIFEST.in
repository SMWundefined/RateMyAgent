# The sdist shipped tests *partially*: setuptools' default heuristic picked up
# tests/test_*.py but not conftest.py, tests/__init__.py, or the test_probes/
# test_targets/ test_outputs/ subpackages, so pytest on an unpacked sdist died
# with `ModuleNotFoundError: No module named 'tests.conftest'`. Ship the whole
# tree instead of pruning it: a reliability scanner whose own suite cannot be
# run from source is a bad joke, and pyproject's `pythonpath = ["."]` means
# `pip install -e ".[dev]" && pytest` works straight out of the tarball.
graft tests

# The sdist ships examples/ too. Two reasons, and the second is the load-bearing
# one: the README points at examples/mcp_server_git_repro.py as the way to check
# a crash report, and that pointer is dead in a tarball that omits it. It is also
# what tests/test_verification_tools.py drives -- so without this line the suite
# passes in the repo and fails from the sdist, which is the gap the sdist test
# run exists to catch.
graft examples

# The sdist ships docs/ because one of them is a promise.
#
# `docs/API-STABILITY.md` states what 1.0 freezes and what it does not, and it
# is the document the version number refers to. A user auditing whether an
# upgrade can break them reads it, and until the 1.0 build was inspected it
# existed only on GitHub -- so a tarball, a vendored copy, or an air-gapped
# install carried the promise's version number and not the promise.
#
# Caught by checking the artifacts rather than assuming, which is the same
# check that found LICENSE and NOTICE were fine and this was not.
graft docs

# PEP 561 marker. Also in package-data for the wheel; listed here so the sdist
# cannot ship a typed package without its marker.
include ratemyagent/py.typed

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
